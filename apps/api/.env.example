NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=mapa_gasolineras_jalapa
DB_USER=jalapa_admin
DB_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SEGURA
DB_SSL=false

DATABASE_URL=postgres://jalapa_admin:CAMBIAR_CONTRASENA@127.0.0.1:5433/mapa_gasolineras_jalapa

CLAVE_INICIAL_ADMIN=CAMBIAR_POR_UNA_CLAVE_DE_12_CARACTERES
CLAVE_INICIAL_GESTOR=CAMBIAR_POR_OTRA_CLAVE_DE_12_CARACTERES

# HU-23: generar con npx web-push generate-vapid-keys (no versionar claves privadas)
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@leprices.gt

# HU-26: proveedor Valhalla (HTTPS remoto o HTTP local).
RUTAS_VALHALLA_URL=https://valhalla1.openstreetmap.de
# Opcional: Python con apps/api/python/requirements.txt para FASTSim.
# RUTAS_FASTSIM_PYTHON=/ruta/al/python

# HU-32: servidor local compatible con OpenAI; cargar el modelo antes de consultar.
VEHICULOS_LLM_URL=http://127.0.0.1:1234/v1
VEHICULOS_LLM_MODELO=qwen3-4b-instruct-2507

# HU-30: bounded local-model inference for documented vehicle research.
VEHICULOS_LLM_MAX_TOKENS=2048
VEHICULOS_LLM_THINKING=planificacion
# Optional local SearXNG endpoint; public-search fallbacks remain available.
# VEHICULOS_SEARXNG_URL=http://127.0.0.1:8080/search
